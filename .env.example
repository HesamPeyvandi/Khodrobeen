# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
# Comma-separated Telegram numeric user IDs that get admin commands + unlimited access
ADMIN_TELEGRAM_IDS=111111111
# Optional. Only needed for LOCAL development inside Iran, where
# api.telegram.org is filtered. Leave empty when deploying on a server
# outside Iran (e.g. Render) - it will reach Telegram directly.
# Works with both HTTP and SOCKS5 proxy URLs (requires the aiohttp-socks
# package, already listed in requirements.txt).
# Examples: http://127.0.0.1:2080  or  socks5://127.0.0.1:1080
TELEGRAM_PROXY_URL=

# --- Database ---
# Local SQLite is fine for development. For production on Render's free
# tier, use a free Postgres instance instead (e.g. Neon - see README) since
# Render's free plan has no persistent disk and SQLite gets wiped on every
# redeploy. Example Postgres URL:
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./data/app.db

# --- Web admin panel ---
FLASK_SECRET_KEY=replace-with-a-long-random-string
ADMIN_PANEL_USERNAME=admin
# Generate with: python -c "from app.web.auth import hash_password; print(hash_password('your-password'))"
ADMIN_PANEL_PASSWORD_HASH=
WEB_HOST=0.0.0.0
WEB_PORT=8000

# --- Scraper / scheduler behaviour ---
POLL_INTERVAL_SECONDS=180
REQUEST_DELAY_SECONDS=2.5
MAX_LISTINGS_PER_SCAN=30
HEADLESS_BROWSER=true
# How long to wait for a page to load before giving up (first attempt).
# Raise this if pages are loading but just slowly, not fully blocked.
PAGE_TIMEOUT_MS=45000
# How many extra attempts to make (with growing timeout/backoff) if a page
# navigation fails, before giving up on that page entirely.
PAGE_GOTO_RETRIES=2
# How long to wait for a Divar listing detail page's real content (title
# or spec rows) to render after navigation succeeds - under network stress
# the page can still be an empty shell well after the page technically
# finishes loading.
DIVAR_DETAIL_RENDER_WAIT_MS=8000
# If Hamrah Mechanic fails this many times in a row within one scan cycle,
# stop trying it for the rest of that cycle instead of retrying a
# destination that's clearly down (each attempt can cost minutes with the
# settings above). Lower this (e.g. to 1) if scans are taking very long.
ESTIMATOR_CIRCUIT_BREAKER_THRESHOLD=3
# How long to wait for the estimate result to render after clicking
# "محاسبه قیمت". The calculation itself genuinely takes 10-15 seconds -
# keep this comfortably above that.
ESTIMATE_RESULT_WAIT_MS=20000
# Optional. Proxy for the SCRAPER's own browser traffic (Divar + Hamrah
# Mechanic) - different from TELEGRAM_PROXY_URL above. Useful if you're
# hosting outside Iran (e.g. Render) and requests to divar.ir are slow or
# time out, since Iranian sites are often behind a CDN/anti-bot layer that
# throttles non-Iranian traffic. Point this at a proxy with a good path
# into Iran. Leave empty if scraping already works fine without it.
# Example: http://user:pass@1.2.3.4:8080
SCRAPER_PROXY_URL=

# --- Subscriptions ---
DEFAULT_TRIAL_DAYS=3
PAYMENT_PROVIDER=manual
